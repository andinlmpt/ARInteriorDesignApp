<mxfile host="app.diagrams.net">
  <diagram name="Use Case Diagram" id="use-case-diagram">
    <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="750" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== System boundary ===== -->
        <mxCell id="SYS" value="AR Interior Design App" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontFamily=Arial;fontSize=14;fillColor=none;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="260" y="40" width="520" height="640" as="geometry" />
        </mxCell>

        <!-- ===== Actors ===== -->
        <mxCell id="U" value="User" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontFamily=Arial;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="110" y="320" width="40" height="80" as="geometry" />
        </mxCell>
        <mxCell id="A" value="Admin" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontFamily=Arial;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="890" y="260" width="40" height="80" as="geometry" />
        </mxCell>
        <mxCell id="AI" value="«system»&lt;br&gt;AI Service" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontFamily=Arial;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="890" y="570" width="40" height="80" as="geometry" />
        </mxCell>

        <!-- ===== Shared use case ===== -->
        <mxCell id="UC_Auth" value="Register / Log In" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="430" y="80" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- ===== User use cases ===== -->
        <mxCell id="UC_Profile" value="Manage Profile" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="180" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="UC_Browse" value="Browse Furniture" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="260" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="UC_AR" value="Visualize Furniture in AR" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="340" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="UC_Measure" value="Measure Room" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="420" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="UC_Save" value="Save Designs &amp;amp; Projects" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="500" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="UC_AIDesign" value="Get AI Design Recommendations" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="580" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- ===== Admin use cases ===== -->
        <mxCell id="UC_Dashboard" value="View Dashboard" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="570" y="180" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="UC_Catalog" value="Manage Furniture Catalog" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="570" y="280" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="UC_Users" value="Manage Users" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="570" y="380" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="UC_Store" value="Manage Store Info" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="570" y="480" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- ===== User associations ===== -->
        <mxCell id="eU1" style="endArrow=none;html=1;rounded=0;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="U" target="UC_Auth">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="130" y="110" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="eU2" style="endArrow=none;html=1;" edge="1" parent="1" source="U" target="UC_Profile">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eU3" style="endArrow=none;html=1;" edge="1" parent="1" source="U" target="UC_Browse">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eU4" style="endArrow=none;html=1;" edge="1" parent="1" source="U" target="UC_AR">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eU5" style="endArrow=none;html=1;" edge="1" parent="1" source="U" target="UC_Measure">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eU6" style="endArrow=none;html=1;" edge="1" parent="1" source="U" target="UC_Save">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eU7" style="endArrow=none;html=1;" edge="1" parent="1" source="U" target="UC_AIDesign">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== Admin associations ===== -->
        <mxCell id="eA1" style="endArrow=none;html=1;rounded=0;exitX=0.5;exitY=0;entryX=1;entryY=0.5;" edge="1" parent="1" source="A" target="UC_Auth">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="910" y="110" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="eA2" style="endArrow=none;html=1;" edge="1" parent="1" source="A" target="UC_Dashboard">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eA3" style="endArrow=none;html=1;" edge="1" parent="1" source="A" target="UC_Catalog">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eA4" style="endArrow=none;html=1;" edge="1" parent="1" source="A" target="UC_Users">
          <mxGeometry relative="1" as="geometry" />
