        <!-- ===== AI Service association ===== -->
        <mxCell id="eAI1" style="endArrow=none;html=1;" edge="1" parent="1" source="AI" target="UC_AIDesign">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
